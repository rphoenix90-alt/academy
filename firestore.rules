rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid);
    }

    function isMember(academyId) {
      return signedIn() && exists(memberPath(academyId));
    }

    function memberRole(academyId) {
      return get(memberPath(academyId)).data.role;
    }

    function isAdmin(academyId) {
      return isMember(academyId) && memberRole(academyId) in ['원장', '관리자'];
    }

    function academyPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId);
    }

    function academyData(academyId) {
      return get(academyPath(academyId)).data;
    }

    function isUnclaimed(academyId) {
      return !exists(academyPath(academyId))
        || !('ownerUid' in academyData(academyId))
        || academyData(academyId).ownerUid == null
        || academyData(academyId).ownerUid == '';
    }

    /** 전화번호 로그인용 Auth 이메일: p{digits}@staff.linkworks.local */
    function phoneAuthEmailFromDigits(digits) {
      return 'p' + digits + '@staff.linkworks.local';
    }

    function authEmailMatchesPhoneDigits(digits) {
      return signedIn()
        && digits is string
        && digits.size() >= 10
        && request.auth.token.email == phoneAuthEmailFromDigits(digits);
    }

    match /academies/{academyId} {
      // 학원 문서: 로그인 사용자는 읽기 가능(직원 연결 시 ownerUid 확인 등)
      allow read: if signedIn()
        || isUnclaimed(academyId)
        || !exists(academyPath(academyId));
      allow create: if signedIn();
      allow update: if isAdmin(academyId)
        || (signedIn() && isUnclaimed(academyId) && request.resource.data.ownerUid == request.auth.uid);

      match /members/{uid} {
        allow read: if isMember(academyId) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid && (
          isUnclaimed(academyId)
          || (
            exists(/databases/$(database)/documents/academies/$(academyId)/instructors/$(request.resource.data.instructorId))
            && get(/databases/$(database)/documents/academies/$(academyId)/instructors/$(request.resource.data.instructorId)).data.authUid == request.auth.uid
            && (
              // 이메일 연결(레거시)
              (
                request.resource.data.email == request.auth.token.email
                && get(/databases/$(database)/documents/academies/$(academyId)/instructors/$(request.resource.data.instructorId)).data.email == request.auth.token.email
              )
              // 전화번호 연결
              || authEmailMatchesPhoneDigits(
                get(/databases/$(database)/documents/academies/$(academyId)/instructors/$(request.resource.data.instructorId)).data.phoneDigits
              )
            )
          )
        );
        allow update: if isAdmin(academyId) || (signedIn() && request.auth.uid == uid);
        allow delete: if isAdmin(academyId);
      }

      match /instructors/{id} {
        allow read: if isMember(academyId)
          || (signedIn() && resource.data.email == request.auth.token.email)
          || (signedIn() && resource.data.authUid == request.auth.uid)
          // 전화번호 로그인: Auth 이메일이 p{phoneDigits}@... 와 일치하면 해당 직원만 조회
          || authEmailMatchesPhoneDigits(resource.data.phoneDigits);

        allow create: if isAdmin(academyId)
          || (signedIn() && isUnclaimed(academyId));

        allow update: if isAdmin(academyId)
          // 본인 계정 연결(최초): authUid 부여
          || (signedIn()
              && (!('authUid' in resource.data) || resource.data.authUid == null || resource.data.authUid == '')
              && request.resource.data.authUid == request.auth.uid
              && (
                resource.data.email == request.auth.token.email
                || authEmailMatchesPhoneDigits(resource.data.phoneDigits)
              ))
          // 이미 연결된 본인 문서 수정(비밀번호 변경 플래그 등)
          || (signedIn() && resource.data.authUid == request.auth.uid);

        allow delete: if isAdmin(academyId);
      }

      match /students/{id} {
        allow read: if isMember(academyId);
        allow create, delete: if isAdmin(academyId);
        allow update: if isMember(academyId);
      }

      match /classes/{id} {
        allow read: if isMember(academyId);
        allow write: if isAdmin(academyId);
      }

      match /textbooks/{id} {
        allow read: if isMember(academyId);
        allow write: if isAdmin(academyId);
      }

      match /meta/{docId} {
        allow read: if isMember(academyId);
        allow write: if isAdmin(academyId)
          || (docId == 'memos' && isMember(academyId));
      }
    }

    // 레거시 마이그레이션: 로그인 사용자 읽기 전용
    match /artifacts/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
